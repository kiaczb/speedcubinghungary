# === SPEEDCUBING HUNGARY - Root Environment Variables ===
# This is a TEMPLATE. Copy to .env and update values for your environment.
# The actual environment is determined by NODE_ENV (development/test/production)
# Never commit actual .env files with real secrets!

# --- Environment Mode ---
# Options: development, test, production
NODE_ENV=development

# --- Frontend (Next.js) Public Variables ---
# These are exposed to the browser
NEXT_PUBLIC_WCA_CLIENT_ID=your_wca_client_id_here
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_LOGIN=http://localhost:8080/login

# --- Backend API URL (server-side only) ---
# Used in Next.js API routes and server-side rendering
# In Docker: use 'api' hostname. Locally: use 'localhost:8080'
SERVER_API_URL=http://api:8080
