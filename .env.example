# === SPEEDCUBING HUNGARY - Environment Variables ===
# This is a TEMPLATE. Copy to .env.development.local, .env.test.local, or .env.production.local
# Never commit actual .env files with real secrets!

# --- Frontend (Next.js) ---
NEXT_PUBLIC_WCA_CLIENT_ID=your_wca_client_id_here
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_LOGIN=http://localhost:8080/login

# Backend API URL (server-side only, used in Next.js API routes)
SERVER_API_URL=http://api:8080
