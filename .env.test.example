# Staging / test environment template.
# On the staging server: copy to `.env.test` and fill in real values.
#   cp .env.test.example .env.test
# Used with: docker compose -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test up -d --build

# --- Compose ---
COMPOSE_PROJECT_NAME=schu_test
# Enables the Caddy reverse proxy / HTTPS service (proxy profile in the base
# compose). web and api are NOT published to the host in test/prod — only Caddy
# (80/443) is exposed publicly; it reaches them over the internal network.
COMPOSE_PROFILES=proxy

# --- Reverse proxy (Caddy) ---
# Single public domain: its DNS must point at this server, with 80/443 open.
# The API is path-routed under WEB_DOMAIN/api (see infra/caddy/Caddyfile), so
# web and api share one origin (first-party cookie, no CORS).
WEB_DOMAIN=test.example.com
ACME_EMAIL=you@example.com

# --- Runtime mode ---
NODE_ENV=production
DEPLOYMENT=test
LOG_LEVEL=info

# --- Database (db service) ---
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=speedcubinghungary_test

# --- API (backend) ---
# Served under WEB_DOMAIN/api (Caddy path routing). The redirect URI must match
# exactly what you register in the WCA OAuth app.
FRONTEND_URL=https://test.example.com
WCA_CLIENT_ID=your_wca_client_id
WCA_CLIENT_SECRET=your_wca_client_secret
WCA_REDIRECT_URI=https://test.example.com/api/login/callback
DATABASE_URL=postgres://change_me:change_me_strong@db:5432/speedcubinghungary_test?sslmode=disable
DB_HOST=db
DB_PORT=5432
DB_USER=change_me
DB_PASSWORD=change_me_strong
DB_NAME=speedcubinghungary_test
JWT_SECRET=generate_with_openssl_rand_hex_32

# --- WCA Live (optional) ---
# Budapest Special reads results live from WCA Live; nothing is stored locally.
# While at least one browser has the page open, the API also subscribes to
# roundUpdated over a websocket so results update in real time. Default shown;
# uncomment to point at another WCA Live instance.
# WCA_LIVE_URL=https://live.worldcubeassociation.org

# --- Web (frontend) ---
# NEXT_PUBLIC_* are baked into the browser bundle at build time (build args).
# The browser talks to the API at WEB_DOMAIN/api (same origin as the site).
# SERVER_API_URL stays the internal Docker service address (server-side fetches).
SERVER_API_URL=http://api:8080
NEXT_PUBLIC_API_URL=https://test.example.com/api
NEXT_PUBLIC_WCA_CLIENT_ID=your_wca_client_id
NEXT_PUBLIC_WCA_REDIRECT_URI=https://test.example.com/api/login/callback
NEXT_PUBLIC_BACKEND_LOGIN=https://test.example.com/api/login

# --- Weekly-report job (compose `jobs` profile) ---
# Only used when you run the weekly-report container; the main stack ignores them.
# Point EMAIL_TO at a FIXED TEST INBOX in staging so real recipients are never
# emailed. The job reuses the DB_* / DATABASE_URL values above (shared database).
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=staging-test-inbox@example.com
EMAIL_APP_PASSWORD=generate_a_gmail_app_password
