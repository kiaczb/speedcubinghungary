# Staging / test environment template.
# On the staging server: copy to `.env.test` and fill in real values.
#   cp .env.test.example .env.test
# Used with: docker compose -f docker-compose.yml -f docker-compose.test.yml --env-file .env.test up -d --build

# --- Compose ---
COMPOSE_PROJECT_NAME=schu_test
# Enables the Caddy reverse proxy / HTTPS service (proxy profile in the base
# compose). web and api are NOT published to the host in test/prod — only Caddy
# (80/443) is exposed publicly; it reaches them over the internal network.
COMPOSE_PROFILES=proxy

# --- Reverse proxy (Caddy) ---
# Public DNS for both must point at this server, with ports 80/443 open.
WEB_DOMAIN=test.example.com
API_DOMAIN=api.test.example.com
ACME_EMAIL=you@example.com

# --- Runtime mode ---
NODE_ENV=production
DEPLOYMENT=test
LOG_LEVEL=info

# --- Database (db service) ---
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=speedcubinghungary_test

# --- API (backend) ---
# Use the staging server's public URLs.
FRONTEND_URL=https://staging.example.com
WCA_CLIENT_ID=your_wca_client_id
WCA_CLIENT_SECRET=your_wca_client_secret
WCA_REDIRECT_URI=https://api.staging.example.com/login/callback
DATABASE_URL=postgres://change_me:change_me_strong@db:5432/speedcubinghungary_test?sslmode=disable
DB_HOST=db
DB_PORT=5432
DB_USER=change_me
DB_PASSWORD=change_me_strong
DB_NAME=speedcubinghungary_test
JWT_SECRET=generate_with_openssl_rand_hex_32

# --- Web (frontend) ---
# NEXT_PUBLIC_* are baked into the browser bundle at build time (build args).
SERVER_API_URL=http://api:8080
NEXT_PUBLIC_API_URL=https://api.staging.example.com
NEXT_PUBLIC_WCA_CLIENT_ID=your_wca_client_id
NEXT_PUBLIC_WCA_REDIRECT_URI=https://api.staging.example.com/login/callback
NEXT_PUBLIC_BACKEND_LOGIN=https://api.staging.example.com/login
