COMPOSE_PROJECT_NAME=speedcubinghungary_test
COMPOSE_PROFILES=proxy

WEB_DOMAIN=test.example.com
ACME_EMAIL=you@example.com

NODE_ENV=production
DEPLOYMENT=test

DB_HOST=db
DB_PORT=5432
DB_USER=change_me
DB_PASSWORD=change_me_strong
DB_NAME=speedcubinghungary_test
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

FRONTEND_URL=https://test.example.com
WCA_CLIENT_ID=your_wca_client_id
WCA_CLIENT_SECRET=your_wca_client_secret
WCA_REDIRECT_URI=https://test.example.com/api/login/callback
JWT_SECRET=generate_with_openssl_rand_hex_32

SERVER_API_URL=http://api:8080
NEXT_PUBLIC_API_URL=https://test.example.com/api

EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=staging-test-inbox@example.com
EMAIL_APP_PASSWORD=generate_a_gmail_app_password
