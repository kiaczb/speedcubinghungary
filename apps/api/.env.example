# === API Server Environment Variables ===
# Copy this file to create environment-specific configs:
#   - .env.development.local (for local development with Docker)
#   - .env.test.local (for running tests)
#   - .env.production.local (for production deployment)

# --- Deployment Mode ---
# Options: development, test, production
DEPLOYMENT=development

# --- Server Configuration ---
FRONTEND_URL=http://localhost:3000

# --- WCA OAuth Configuration ---
# Get these from https://www.worldcubeassociation.org/oauth/applications
WCA_CLIENT_ID=your_wca_client_id_here
WCA_CLIENT_SECRET=your_wca_client_secret_here
WCA_REDIRECT_URI=http://localhost:8080/login/callback

# --- Database Configuration ---
# For development with Docker: use 'db' as hostname
# For test: use 'localhost' or separate test database
# For production: use proper managed database

DATABASE_URL=postgres://username:password@db:5432/speedcubinghungary_dev?sslmode=disable

# Individual database connection params (used by some drivers)
DB_HOST=db
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=speedcubinghungary_dev

# --- JWT Configuration ---
# CRITICAL: Generate a strong random secret for each environment
# Development: can be a fixed value for local testing
# Test: can be a fixed value for CI/CD
# Production: MUST be a strong random secret (at least 32 bytes)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_strong_random_secret_hex_here_at_least_32_bytes

# --- Logging ---
LOG_LEVEL=debug
