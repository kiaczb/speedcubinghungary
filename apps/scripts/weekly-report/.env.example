# Weekly-report job environment template.
# Copy to `.env` (git-ignored) and fill in real values:
#   cp .env.example .env
#
# Loaded via python-dotenv in config.py. Never commit the real `.env` or paste
# secrets into any tracked file.

# --- Email (SMTP via Gmail) ---
EMAIL_FROM=your_gmail_address@gmail.com
# Point EMAIL_TO at a fixed test inbox when running this job outside production.
EMAIL_TO=recipient@example.com
EMAIL_APP_PASSWORD=generate_a_gmail_app_password

# --- Database (shared with the Go backend) ---
# A full DATABASE_URL takes precedence when set; otherwise the DB_* vars below
# are used. Mirrors apps/api/internal/db/postgres.go.
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/speedcubinghungary_dev?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=speedcubinghungary_dev
DB_USER=your_db_user
DB_PASSWORD=your_db_password
