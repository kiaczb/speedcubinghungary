# Production environment template.
# On the production server: copy to `.env.prod` and fill in real values.
#   cp .env.prod.example .env.prod
# Used with: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- Compose ---
COMPOSE_PROJECT_NAME=speedcubinghungary_prod
# Enables the Caddy reverse proxy / HTTPS service (proxy profile in the base
# compose). web and api are NOT published to the host in test/prod — only Caddy
# (80/443) is exposed publicly; it reaches them over the internal network.
COMPOSE_PROFILES=proxy

# --- Reverse proxy (Caddy) ---
# Single public domain: its DNS must point at this server, with 80/443 open.
# The API is path-routed under WEB_DOMAIN/api (see infra/caddy/Caddyfile), so
# web and api share one origin (first-party cookie, no CORS).
WEB_DOMAIN=example.com
ACME_EMAIL=you@example.com

# --- Runtime mode ---
NODE_ENV=production
DEPLOYMENT=production
LOG_LEVEL=info

# --- Database (shared by the db, api and weekly-report services) ---
# Single source of truth: DATABASE_URL is built from these below, and
# docker-compose.yml also feeds them to the postgres image as POSTGRES_*.
# Change the value once, here.
DB_HOST=db
DB_PORT=5432
DB_USER=change_me
DB_PASSWORD=change_me_strong
DB_NAME=speedcubinghungary
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable

# --- API (backend) ---
FRONTEND_URL=https://example.com
WCA_CLIENT_ID=your_wca_client_id
WCA_CLIENT_SECRET=your_wca_client_secret
WCA_REDIRECT_URI=https://example.com/api/login/callback
JWT_SECRET=generate_with_openssl_rand_hex_32

# --- WCA Live (optional) ---
# Budapest Special reads results live from WCA Live; nothing is stored locally.
# While at least one browser has the page open, the API also subscribes to
# roundUpdated over a websocket so results update in real time. Default shown;
# uncomment to point at another WCA Live instance.
# WCA_LIVE_URL=https://live.worldcubeassociation.org

# --- Web (frontend) ---
# NEXT_PUBLIC_* are baked into the browser bundle at build time (build args).
SERVER_API_URL=http://api:8080
NEXT_PUBLIC_API_URL=https://example.com/api
NEXT_PUBLIC_WCA_CLIENT_ID=your_wca_client_id
NEXT_PUBLIC_WCA_REDIRECT_URI=https://example.com/api/login/callback
NEXT_PUBLIC_BACKEND_LOGIN=https://example.com/api/login

# --- Weekly-report job (compose `jobs` profile) ---
# Only used when you run the weekly-report container; the main stack ignores them.
# In production EMAIL_TO is the real recipient list. The job reuses the DB_* /
# DATABASE_URL values above (shared database).
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=recipient@example.com
EMAIL_APP_PASSWORD=generate_a_gmail_app_password
