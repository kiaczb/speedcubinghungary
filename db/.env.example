# === PostgreSQL Database Environment Variables ===
# Used by docker-compose.yml and the API server
# This single .env file handles all environments

# PostgreSQL Admin User
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=speedcubinghungary_dev

# Note: These are referenced by the docker-compose.yml
# The API server uses DATABASE_URL which is constructed from DB_* variables
