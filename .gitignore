# --- Environment & Secrets ---
# Never commit actual .env files - they contain secrets!
# Ignores .env, .env.dev, .env.test, .env.prod, .env.local, etc...
.env
.env.*

# ...but keep the committed templates (.env.example, .env.dev.example, ...)
!.env.example
!.env.*.example

# Docker compose overrides
docker-compose.override.yml

