# Local development environment template.
# Copy to `.env.dev` and adjust if needed:
#   cp .env.dev.example .env.dev
# Used with: docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up

# --- Compose ---
COMPOSE_PROJECT_NAME=schu_dev

# --- Host port mappings ---
WEB_PORT=3000
API_PORT=8080
DB_PORT_HOST=5432

# --- Runtime mode ---
NODE_ENV=development
DEPLOYMENT=development
LOG_LEVEL=debug

# --- Database (db service) ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=speedcubinghungary_dev

# --- API (backend) ---
FRONTEND_URL=http://localhost:3000
WCA_CLIENT_ID=your_wca_client_id
WCA_CLIENT_SECRET=your_wca_client_secret
WCA_REDIRECT_URI=http://localhost:8080/login/callback
DATABASE_URL=postgres://your_db_user:your_db_password@db:5432/speedcubinghungary_dev?sslmode=disable
DB_HOST=db
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=speedcubinghungary_dev
JWT_SECRET=generate_with_openssl_rand_hex_32

# --- WCA Live (optional) ---
# Budapest Special reads results live from WCA Live; nothing is stored locally.
# While at least one browser has the page open, the API also subscribes to
# roundUpdated over a websocket so results update in real time. Default shown;
# uncomment to point at another WCA Live instance.
# WCA_LIVE_URL=https://live.worldcubeassociation.org

# --- Web (frontend) ---
SERVER_API_URL=http://api:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WCA_CLIENT_ID=your_wca_client_id
NEXT_PUBLIC_WCA_REDIRECT_URI=http://localhost:8080/login/callback
NEXT_PUBLIC_BACKEND_LOGIN=http://localhost:8080/login

# --- Weekly-report job (compose `jobs` profile) ---
# Optional locally — only needed if you run the weekly-report container:
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.dev.yml \
#     --env-file .env.dev --profile jobs run --rm weekly-report
# Always point EMAIL_TO at your own test inbox in dev.
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TO=your_test_inbox@example.com
EMAIL_APP_PASSWORD=generate_a_gmail_app_password
