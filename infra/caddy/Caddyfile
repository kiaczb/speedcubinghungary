# Reverse proxy with automatic HTTPS (Let's Encrypt).
# Single public domain, path-routed (comes from the environment):
#   WEB_DOMAIN  -> serves the whole site
#   ACME_EMAIL  -> contact address for Let's Encrypt / expiry notices
#
# The API lives under WEB_DOMAIN/api/*; everything else is the Next.js web app.
# Because web and api share one origin, the auth cookie is first-party and CORS
# is a non-issue.
#
# Caddy provisions and renews a trusted cert automatically, as long as the
# domain's public DNS points at this server and 80/443 are open.
{
	email {$ACME_EMAIL}
}

{$WEB_DOMAIN} {
	# API under /api/*. handle_path strips the /api prefix, so the Go API still
	# sees root paths (/posts, /login/callback, /me, ...) exactly as before.
	handle_path /api/* {
		reverse_proxy api:8080
	}

	# Everything else -> the Next.js frontend.
	handle {
		reverse_proxy web:3000
	}
}
