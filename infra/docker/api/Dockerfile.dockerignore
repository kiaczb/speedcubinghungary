# Per-Dockerfile ignore for the API build (context: repo root).
# Excludes everything the API image doesn't need, keeping the build context lean.
.git
.github
docs
infra
# entrypoint.sh is COPYed by the Dockerfile itself (root-drop for uploads
# volume permissions) — un-ignore it despite the blanket `infra` exclusion
# above, or the build fails with "not found" (see CLAUDE.md §17).
!infra/docker/api/entrypoint.sh
apps/web
apps/scripts
**/node_modules
**/.next
apps/api/tmp
apps/api/vendor
*.log
*.md
.env
.env.*
!.env.*.example
postgres_data*/
