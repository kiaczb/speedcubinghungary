# Fallback .dockerignore for the repo-root build context.
# Both api and web images use per-Dockerfile ignores (infra/docker/{api,web}/Dockerfile.dockerignore)
# which take precedence in BuildKit builds. This file applies only when those are not picked up.
.git
.github
docs
infra
**/node_modules
**/.next
apps/api/tmp
apps/api/vendor
*.log
*.md
# Secrets / env files never belong in an image.
.env
.env.*
!.env.*.example
postgres_data*/
